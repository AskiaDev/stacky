  "repository": {
    "type": "git",
    "url": "git+https://github.com/AskiaDev/stacky.git"
  },
  "homepage": "https://github.com/AskiaDev/stacky#readme",
  "bugs": {
    "url": "https://github.com/AskiaDev/stacky/issues"
  },
  "dependencies": {
    "@clack/prompts": "^0.8.2",
