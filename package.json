{
  "name": "stacky-cli",
  "version": "0.1.0",
  "description": "Framework-agnostic CLI scaffolding tool for backend applications",
  "type": "module",
  "bin": {
    "stacky": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
